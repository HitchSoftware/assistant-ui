      "optional": true
    }
  },
  "devDependencies": {
    "@hitchsoftware/assistant-ui-core": "workspace:*",
    "@hitchsoftware/assistant-ui-react": "workspace:*",
    "@hitchsoftware/assistant-ui-store": "workspace:*",
    "@hitchsoftware/assistant-ui-x-buildutils": "workspace:*",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
