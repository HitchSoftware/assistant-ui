    "@lexical/utils": "^0.49.0",
    "lexical": "^0.49.0"
  },
  "peerDependencies": {
    "@hitchsoftware/assistant-ui-react": "^0.15.0",
    "@hitchsoftware/assistant-ui-core": "^0.3.0",
    "@hitchsoftware/assistant-ui-store": "*",
