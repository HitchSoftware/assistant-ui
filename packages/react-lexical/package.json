{
  "name": "@hitchsoftware/assistant-ui-react-lexical",
  "version": "0.2.9",
  "description": "Lexical-based rich text composer for assistant-ui with @-mention support",
  "keywords": [
    "lexical",
    "rich-text",
    "mention",
    "assistant-ui",
    "react",
    "ai",
    "chat"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
