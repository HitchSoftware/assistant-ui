{
  "extends": "@hitchsoftware/assistant-ui-x-buildutils/ts/next",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/components/assistant-ui/*": [
        "../../packages/ui/src/components/assistant-ui/*"
      ],
      "@/components/ui/*": [
        "../../packages/ui/src/components/ui/base/*",
        "../../packages/ui/src/components/ui/radix/*"
      ],
      "@/components/ui/radix/*": [
        "../../packages/ui/src/components/ui/radix/*"
      ],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@hitchsoftware/assistant-ui-ui/*": ["../../packages/ui/src/*"],
      "@hitchsoftware/assistant-ui-store/client": ["../../packages/store/src/client"],
      "@assistant-ui/*": ["../../packages/*/src"],
      "@hitchsoftware/assistant-ui-core/*": ["../../packages/core/src/*"],
      "@hitchsoftware/assistant-ui-react/*": ["../../packages/react/src/*"],
      "@hitchsoftware/assistant-ui-tap/*": ["../../packages/tap/src/*"],
      "@hitchsoftware/assistant-stream": ["../../packages/assistant-stream/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
